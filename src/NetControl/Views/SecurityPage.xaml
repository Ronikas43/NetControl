<UserControl x:Class="NetControl.Views.SecurityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Security" Style="{StaticResource H1}"/>
                <TextBlock Text="New/unknown device alerts and ARP spoofing detection. Detection also works without Npcap via active probes."
                           Style="{StaticResource Sub}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Probe gateway now" Margin="0,0,8,0" Command="{Binding ProbeNowCommand}"/>
                <Button Content="Clear events" Style="{StaticResource DangerButton}" Command="{Binding ClearEventsCommand}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ARP monitor" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding MonitorStatus}" TextWrapping="Wrap" FontSize="12.5"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock Text="Gateway baseline" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding GatewayStatus}" TextWrapping="Wrap" FontSize="12.5"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="14,0,0,0">
                    <TextBlock Text="Privileges" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding AdminStatus}" TextWrapping="Wrap" FontSize="12.5"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <DataGrid ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Sev" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Ellipse Width="9" Height="9" HorizontalAlignment="Center"
                                         Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat='{}{0:MM-dd HH:mm:ss}'}" Width="140"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="130"/>
                    <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="150"/>
                    <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="120"/>
                    <DataGridTextColumn Header="Details" Binding="{Binding Message}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Respond to an event" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <TextBlock Text="Select a security event above; if it belongs to a known device you can trust it here."
                               Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                              DisplayMemberPath="DisplayName" Margin="0,0,0,8"/>
                    <Button Content="Mark device as trusted" Style="{StaticResource SuccessButton}"
                            Command="{Binding MarkTrustedCommand}" Margin="0,0,0,8"/>
                    <TextBlock Text="Tip: ARP spoofing alerts name the claimed MAC - compare it with the gateway baseline above before acting."
                               Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
