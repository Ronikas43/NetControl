<UserControl x:Class="NetControl.Views.BandwidthPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NetControl.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Bandwidth" Style="{StaticResource H1}"/>
            <TextBlock Text="Real adapter throughput, session totals, and per-device policies where the router supports them."
                       Style="{StaticResource Sub}" Margin="0,4,0,14"/>

            <!-- Live speeds -->
            <UniformGrid Columns="4" Margin="0,0,0,14">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Download (live)" Style="{StaticResource Sub}"/>
                        <TextBlock Text="{Binding DownloadSpeed}" Style="{StaticResource StatValue}"
                                   Foreground="{StaticResource Brush.Accent}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Upload (live)" Style="{StaticResource Sub}"/>
                        <TextBlock Text="{Binding UploadSpeed}" Style="{StaticResource StatValue}"
                                   Foreground="{StaticResource Brush.Success}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Downloaded (session)" Style="{StaticResource Sub}"/>
                        <TextBlock Text="{Binding SessionDownload}" Style="{StaticResource StatValue}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Uploaded (session)" Style="{StaticResource Sub}"/>
                        <TextBlock Text="{Binding SessionUpload}" Style="{StaticResource StatValue}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Traffic over time (live)" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <controls:SpeedChart x:Name="Chart" Height="200"/>
                </StackPanel>
            </Border>

            <!-- Per-device policy -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Per-device bandwidth limits" Style="{StaticResource H2}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding RouterStatus}" Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Device" Style="{StaticResource SectionHeader}"/>
                            <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                      DisplayMemberPath="DisplayName" Width="200" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Download limit (kbps)" Style="{StaticResource SectionHeader}"/>
                            <TextBox Text="{Binding LimitDownKbps, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                            <TextBlock Text="Upload limit (kbps)" Style="{StaticResource SectionHeader}"/>
                            <TextBox Text="{Binding LimitUpKbps, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <Button Grid.Column="3" Content="Apply limit" Style="{StaticResource AccentButton}"
                                Command="{Binding ApplyLimitCommand}" VerticalAlignment="Bottom" Margin="10,0,8,0"/>
                        <Button Grid.Column="4" Content="Remove limit" Command="{Binding RemoveLimitCommand}"
                                VerticalAlignment="Bottom"/>
                    </Grid>

                    <Border Background="{StaticResource Brush.Panel}" CornerRadius="6" Padding="10,7" Margin="0,12,0,0">
                        <TextBlock Text="{Binding LimitStatus}" TextWrapping="Wrap" FontSize="12.5"
                                   Foreground="{StaticResource Brush.Text}"/>
                    </Border>
                    <TextBlock Text="{Binding SourceNote}" Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
