<UserControl x:Class="NetControl.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NetControl.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Dashboard" Style="{StaticResource H1}"/>
                    <TextBlock Text="Live overview of your network - all numbers come from real scans and adapter counters."
                               Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Rescan now" Style="{StaticResource AccentButton}"
                        Command="{Binding RescanCommand}" VerticalAlignment="Center"/>
            </Grid>

            <!-- Stat cards -->
            <UniformGrid Columns="6" Margin="0,0,0,14">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Total devices" Style="{StaticResource Sub}"/>
                        <TextBlock Text="{Binding TotalDevices}" Style="{StaticResource StatValue}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Online" Style="{StaticResource Sub}"/>
                        <TextBlock Text="{Binding OnlineDevices}" Style="{StaticResource StatValue}"
                                   Foreground="{StaticResource Brush.Success}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Offline" Style="{StaticResource Sub}"/>
                        <TextBlock Text="{Binding OfflineDevices}" Style="{StaticResource StatValue}"
                                   Foreground="{StaticResource Brush.SubText}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Unknown" Style="{StaticResource Sub}"/>
                        <TextBlock Text="{Binding UnknownDevices}" Style="{StaticResource StatValue}"
                                   Foreground="{StaticResource Brush.Warning}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Trusted" Style="{StaticResource Sub}"/>
                        <TextBlock Text="{Binding TrustedDevices}" Style="{StaticResource StatValue}"
                                   Foreground="{StaticResource Brush.Accent}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Blocked" Style="{StaticResource Sub}"/>
                        <TextBlock Text="{Binding BlockedDevices}" Style="{StaticResource StatValue}"
                                   Foreground="{StaticResource Brush.Danger}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Speed chart -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Network traffic (live, last 10 minutes)" Style="{StaticResource H2}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding DownloadSpeed, StringFormat='↓ {0}'}"
                                       Foreground="{StaticResource Brush.Accent}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding UploadSpeed, StringFormat='↑ {0}'}"
                                       Foreground="{StaticResource Brush.Success}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                    <controls:SpeedChart x:Name="Chart" Height="190"/>
                    <Grid Margin="0,10,0,0">
                        <TextBlock Text="{Binding AdapterInfo}" Style="{StaticResource Sub}"/>
                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource Sub}">
                            <Run Text="Session: ↓ "/><Run Text="{Binding SessionDownload, Mode=OneWay}"/>
                            <Run Text="   ↑ "/><Run Text="{Binding SessionUpload, Mode=OneWay}"/>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Lists -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Recent activity" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding RecentActivity}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1"
                                            Padding="0,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Message}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource Brush.Text}"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource Brush.SubText}">
                                                <Run Text="{Binding Timestamp, Mode=OneWay, StringFormat='{}{0:MM-dd HH:mm:ss}'}"/>
                                                <Run Text=" - "/><Run Text="{Binding Type, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Security alerts" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding RecentAlerts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,6">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,4,8,0"
                                                     Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Message}" FontSize="12.5" TextWrapping="Wrap"
                                                           MaxWidth="420" Foreground="{StaticResource Brush.Text}"/>
                                                <TextBlock FontSize="11" Foreground="{StaticResource Brush.SubText}">
                                                    <Run Text="{Binding Timestamp, Mode=OneWay, StringFormat='{}{0:MM-dd HH:mm:ss}'}"/>
                                                    <Run Text=" - "/><Run Text="{Binding Type, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Enforcement status: " FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding EnforcementInfo}" Foreground="{StaticResource Brush.SubText}"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
