<UserControl x:Class="NetControl.Views.DevicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Devices" Style="{StaticResource H1}"/>
                <TextBlock Text="Discovered by ARP/ping scanning. Names come from NetBIOS/reverse-DNS and the MAC vendor database."
                           Style="{StaticResource Sub}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Rescan" Style="{StaticResource AccentButton}" Command="{Binding RescanCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource BoolToVisInv}}"/>
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center" FontSize="13" Margin="0,0,10,0"
                             ToolTip="Search by name, IP, MAC, vendor or hostname"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding FilterCategory}" Width="120" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding OnlineFilters}"
                              SelectedItem="{Binding FilterOnline}" Width="100"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Block internet" Style="{StaticResource DangerButton}" Margin="0,0,8,0"
                            Click="OnBlockInternet"/>
                    <Button Content="Restore access" Style="{StaticResource SuccessButton}" Margin="0,0,8,0"
                            Click="OnRestoreAccess"/>
                    <Button Content="Restore all devices" Margin="0,0,8,0" Click="OnRestoreAll"/>
                    <Button Content="Trust / Untrust" Margin="0,0,8,0" Click="OnToggleTrust"/>
                    <Button Content="Mark offline" Margin="0,0,8,0" Click="OnMarkOffline"/>
                    <Button Content="Copy info" Click="OnCopyInfo"/>
                    <TextBlock Text="{Binding StatusMessage}" Margin="14,0,0,0" VerticalAlignment="Center"
                               Style="{StaticResource Sub}" MaxWidth="520" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main area: list + detail -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="DevicesGrid" Grid.Column="0"
                      ItemsSource="{Binding FilteredDevices}"
                      SelectedItem="{Binding SelectedDevice}"
                      Style="{StaticResource {x:Type DataGrid}}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="State" Width="64">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                             Fill="{Binding Online, Converter={StaticResource OnlineToBrush}}"/>
                                    <TextBlock Text="B" FontSize="10" FontWeight="Bold" Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.Danger}"
                                               Visibility="{Binding Blocked, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Name" Width="*" MinWidth="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding DisplayName}"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                               Foreground="{StaticResource Brush.SubText}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Subtitle, Converter={StaticResource StringToVis}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="120"/>
                    <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="150"/>
                    <DataGridTextColumn Header="OS" Binding="{Binding OsGuess}" Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Brush.SubText}"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="90"/>
                    <DataGridTextColumn Header="Confidence" Binding="{Binding ConfidenceLabel}" Width="90"/>
                    <DataGridCheckBoxColumn Header="Trusted" Binding="{Binding Trusted, Mode=OneWay}" Width="70"/>
                    <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen, StringFormat='{}{0:HH:mm:ss}'}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Detail panel -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedDevice}">
                        <TextBlock Text="Device details" Style="{StaticResource H2}"/>
                        <TextBlock Text="Select a device to view and edit its details."
                                   Style="{StaticResource Sub}" Margin="0,2,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                            <Border Background="{StaticResource Brush.AccentDim}" CornerRadius="4" Padding="6,2"
                                    Visibility="{Binding Label, Converter={StaticResource StringToVis}}">
                                <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Display name" Style="{StaticResource SectionHeader}"/>
                        <TextBox Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                        <Button Content="Save name" Command="{Binding DataContext.RenameDeviceCommand,
                                RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,12"/>

                        <TextBlock Text="IP address" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding Ip}" FontSize="14" Margin="0,0,0,10"/>

                        <TextBlock Text="MAC address" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding Mac}" FontSize="14" Margin="0,0,0,10"/>

                        <TextBlock Text="Manufacturer" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding Vendor}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <TextBlock Text="Hostname" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding Hostname}" FontSize="13" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <TextBlock Text="Advertised name (mDNS/SSDP)" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding FriendlyNameSeen}" FontSize="13" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <TextBlock Text="Operating system (estimated)" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding OsGuess}" FontSize="13" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <TextBlock Text="Model" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding Model}" FontSize="13" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <TextBlock Text="Identification confidence" Style="{StaticResource SectionHeader}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="{Binding ConfidenceLabel}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Confidence, StringFormat=' ({0}/100)'}" FontSize="12"
                                       Foreground="{StaticResource Brush.SubText}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Evidence sources" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding Sources}" FontSize="12"
                                   Foreground="{StaticResource Brush.SubText}" TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Category" Style="{StaticResource SectionHeader}"/>
                        <ComboBox x:Name="CategoryBox" SelectedItem="{Binding Category, Mode=OneWay}" Margin="0,0,0,12"
                                  SelectionChanged="OnCategoryChanged"/>

                        <TextBlock Text="First seen" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding FirstSeen, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Margin="0,0,0,10"/>
                        <TextBlock Text="Last seen" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding LastSeen, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <CheckBox Content="Trusted device" IsChecked="{Binding Trusted}" IsEnabled="False"
                                      VerticalAlignment="Center"/>
                            <CheckBox Content="Blocked" IsChecked="{Binding Blocked}" IsEnabled="False" Margin="16,0,0,0"
                                      VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Notes" Style="{StaticResource SectionHeader}"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" Margin="0,0,0,8"/>
                        <Button Content="Save notes" Command="{Binding DataContext.SaveDeviceCommand,
                                RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
