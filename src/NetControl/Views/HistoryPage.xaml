<UserControl x:Class="NetControl.Views.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Connection history" Style="{StaticResource H1}"/>
                <TextBlock Text="Every connection, disconnection, IP change and access action, stored in SQLite."
                           Style="{StaticResource Sub}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Content="Clear history" Style="{StaticResource DangerButton}" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Command="{Binding ClearHistoryCommand}"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search messages, IPs and MAC addresses" VerticalContentAlignment="Center"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Types}" SelectedItem="{Binding TypeFilter}" Margin="10,0,0,0"/>
                <DatePicker Grid.Column="2" SelectedDate="{Binding FromDate}" Margin="10,0,0,0"
                            ToolTip="From date"/>
                <DatePicker Grid.Column="3" SelectedDate="{Binding ToDate}" Margin="10,0,0,0" ToolTip="To date"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button Content="Search" Style="{StaticResource AccentButton}" Command="{Binding SearchCommand}" Margin="0,0,8,0"/>
                    <Button Content="Clear filters" Command="{Binding ClearFiltersCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <DataGrid ItemsSource="{Binding Entries}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat='{}{0:MM-dd HH:mm:ss}'}" Width="140"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110"/>
                    <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="150"/>
                    <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="120"/>
                    <DataGridTextColumn Header="Event" Binding="{Binding Message}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
                <StackPanel>
                    <TextBlock Text="Per-device history" Style="{StaticResource H2}"/>
                    <TextBlock Text="Right-click a device on the Devices page and use 'Copy info', or select a device here:"
                               Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                    <ComboBox ItemsSource="{Binding DataContext.Devices, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="DisplayName" Margin="0,0,0,8"/>
                    <Button Content="Show device history" Click="OnShowDeviceHistory" Margin="0,0,0,8"/>
                    <ListBox ItemsSource="{Binding DeviceHistory}" MaxHeight="420">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,3">
                                    <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap"/>
                                    <TextBlock FontSize="10.5" Foreground="{StaticResource Brush.SubText}">
                                        <Run Text="{Binding Timestamp, Mode=OneWay, StringFormat='{}{0:MM-dd HH:mm:ss}'}"/>
                                        <Run Text=" - "/><Run Text="{Binding Type, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding ResultCount, StringFormat='{}{0} entries'}" Style="{StaticResource Sub}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
