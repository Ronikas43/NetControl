<Window x:Class="NetControl.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NetControl.ViewModels"
        xmlns:views="clr-namespace:NetControl.Views"
        xmlns:controls="clr-namespace:NetControl.Controls"
        Title="NetControl" Height="760" Width="1280" MinHeight="560" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.WindowBg}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DevicesViewModel}">
            <views:DevicesPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BandwidthViewModel}">
            <views:BandwidthPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SchedulerViewModel}">
            <views:SchedulerPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SecurityViewModel}">
            <views:SecurityPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MacViewModel}">
            <views:MacPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Sidebar ============ -->
        <Border Grid.Column="0" Background="{StaticResource Brush.SidebarBg}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,22,16,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="8"
                                Background="{StaticResource Brush.Accent}">
                            <TextBlock Text="N" FontSize="20" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="NetControl" FontSize="19" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Text}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Network management" FontSize="11"
                               Foreground="{StaticResource Brush.SubText}" Margin="2,8,0,0"/>
                </StackPanel>

                <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                         Margin="10,0,10,10" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,2">
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                           FontSize="15" Width="26"
                                           Foreground="{StaticResource Brush.SubText}"/>
                                <TextBlock Text="{Binding Label}" FontSize="14" Margin="6,0,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                            <Setter Property="Padding" Value="10,9"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background"
                                                        Value="{StaticResource Brush.Card}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background"
                                                        Value="{StaticResource Brush.AccentDim}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============ Content ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Banner -->
            <Border Grid.Row="0" DockPanel.Dock="Top" HorizontalAlignment="Center"
                    VerticalAlignment="Top" Margin="0,10,0,0"
                    Background="{StaticResource Brush.Card}"
                    BorderBrush="{StaticResource Brush.Warning}" BorderThickness="1"
                    CornerRadius="8" Padding="14,8" MaxWidth="720"
                    Visibility="{Binding BannerVisible, Converter={StaticResource BoolToVis}}"
                    Panel.ZIndex="10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="!" FontWeight="Bold" FontSize="14"
                               Foreground="{StaticResource Brush.Warning}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding BannerText}" Margin="10,0,0,0" FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.Text}" MaxWidth="600" VerticalAlignment="Center"/>
                    <Button Content="x" Padding="6,2" Margin="12,0,0,0" FontWeight="Bold"
                            Command="{Binding CloseBannerCommand}"/>
                </StackPanel>
            </Border>

            <ContentControl Grid.Row="0" Content="{Binding CurrentViewModel}" Margin="20,14,20,0"/>

            <!-- Status bar -->
            <Border Grid.Row="1" Background="{StaticResource Brush.SidebarBg}" Padding="14,7" Margin="0,10,0,0"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                 Fill="{Binding IsScanning, Converter={StaticResource StatusToBrush}}"/>
                        <TextBlock Text="{Binding ScanStatus}" FontSize="11.5" Margin="8,0,0,0"
                                   Foreground="{StaticResource Brush.SubText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding AdapterText}" FontSize="11.5"
                               Foreground="{StaticResource Brush.SubText}" Margin="0,0,18,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding SpeedText}" FontSize="11.5"
                               Foreground="{StaticResource Brush.Accent}" Margin="0,0,18,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding RouterStatusText}" FontSize="11.5"
                               Foreground="{StaticResource Brush.SubText}" Margin="0,0,18,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="{Binding ArpStatusText}" FontSize="11.5"
                               Foreground="{StaticResource Brush.SubText}" Margin="0,0,18,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="{Binding Title}" FontSize="11.5" FontWeight="Bold"
                               Foreground="{StaticResource Brush.SubText}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
