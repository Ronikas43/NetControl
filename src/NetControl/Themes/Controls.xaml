<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:NetControl.Controls">

    <controls:BoolToVisibilityConverter x:Key="BoolToVis"/>
    <controls:BoolToVisibilityConverter x:Key="BoolToVisInv" Invert="True"/>
    <controls:OnlineToBrushConverter x:Key="OnlineToBrush"/>
    <controls:BoolToBrushConverter x:Key="BoolToBrush"/>
    <controls:BoolToBrushConverter x:Key="StatusToBrush" TrueColor="#34C77B" FalseColor="#F5A623"/>
    <controls:SeverityToBrushConverter x:Key="SeverityToBrush"/>
    <controls:BoolToTextConverter x:Key="BoolToText"/>
    <controls:BoolToTextConverter x:Key="EnabledText" TrueText="Currently ENABLED" FalseText="Currently disabled"/>
    <controls:DeviceCategoryConverter x:Key="CategoryConverter"/>
    <controls:StringEmptyToVisibilityConverter x:Key="StringToVis"/>
    <controls:StringEmptyToVisibilityConverter x:Key="StringToVisInv" Invert="True"/>

    <!-- Expander look -->
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- GroupBox-like section header -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.SubText}"/>
        <Setter Property="Margin" Value="0,4,0,8"/>
    </Style>

    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>
