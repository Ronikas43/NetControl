<UserControl x:Class="NetControl.Views.SchedulerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Scheduler" Style="{StaticResource H1}"/>
                <TextBlock Text="Recurring access windows. Rules persist across restarts and revert automatically when a window ends."
                           Style="{StaticResource Sub}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Content="Evaluate now" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Command="{Binding EvaluateNowCommand}"/>
        </Grid>

        <!-- New schedule -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="New schedule" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Name" Style="{StaticResource SectionHeader}"/>
                        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Device" Style="{StaticResource SectionHeader}"/>
                        <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                  DisplayMemberPath="DisplayName"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                        <TextBlock Text="Action" Style="{StaticResource SectionHeader}"/>
                        <ComboBox SelectedItem="{Binding NewAction}">
                            <system:String xmlns:system="clr-namespace:System;assembly=mscorlib">Block</system:String>
                            <system:String xmlns:system="clr-namespace:System;assembly=mscorlib">Allow</system:String>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="10,0,0,0">
                        <TextBlock Text="Start (HH:mm)" Style="{StaticResource SectionHeader}"/>
                        <TextBox Text="{Binding NewStart}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Margin="10,0,0,0">
                        <TextBlock Text="End (HH:mm)" Style="{StaticResource SectionHeader}"/>
                        <TextBox Text="{Binding NewEnd}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <CheckBox Content="Sun" IsChecked="{Binding Day0}" Margin="0,0,10,0"/>
                    <CheckBox Content="Mon" IsChecked="{Binding Day1}" Margin="0,0,10,0"/>
                    <CheckBox Content="Tue" IsChecked="{Binding Day2}" Margin="0,0,10,0"/>
                    <CheckBox Content="Wed" IsChecked="{Binding Day3}" Margin="0,0,10,0"/>
                    <CheckBox Content="Thu" IsChecked="{Binding Day4}" Margin="0,0,10,0"/>
                    <CheckBox Content="Fri" IsChecked="{Binding Day5}" Margin="0,0,10,0"/>
                    <CheckBox Content="Sat" IsChecked="{Binding Day6}" Margin="0,0,14,0"/>
                    <Button x:Name="AddButton" Content="Save schedule" Style="{StaticResource AccentButton}" Command="{Binding AddScheduleCommand}"/>
                    <TextBlock Text="{Binding Message}" Margin="14,0,0,0" VerticalAlignment="Center"
                               Style="{StaticResource Sub}" MaxWidth="520" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock Text="Action 'Block' revokes internet during the window and restores it afterwards. 'Allow' restores access during the window."
                           Style="{StaticResource Sub}" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Schedule list -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Schedules}" SelectedItem="{Binding SelectedSchedule}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
                <DataGridTextColumn Header="Target" Binding="{Binding Mac}" Width="160"/>
                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="80"/>
                <DataGridTextColumn Header="Days" Binding="{Binding DaysText}" Width="120"/>
                <DataGridTextColumn Header="Window" Binding="{Binding WindowText}" Width="130"/>
                <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled, Mode=OneWay}" Width="80"/>
                <DataGridTextColumn Header="State" Binding="{Binding StateText}" Width="110"/>
                <DataGridTextColumn Header="Last result" Binding="{Binding LastResult}" Width="*"/>
                <DataGridTemplateColumn Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Edit" Padding="8,3" Margin="0,0,6,0" Click="OnEdit"/>
                                <Button Content="On/Off" Padding="8,3" Margin="0,0,6,0" Click="OnToggleEnabled"/>
                                <Button Content="Delete" Padding="8,3" Style="{StaticResource DangerButton}" Click="OnDelete"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
