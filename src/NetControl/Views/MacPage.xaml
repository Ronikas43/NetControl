<UserControl x:Class="NetControl.Views.MacPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="MAC tools" Style="{StaticResource H1}"/>
                <TextBlock Text="Inspect and copy MAC addresses; change your own adapter MAC where the driver supports it."
                           Style="{StaticResource Sub}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Content="Refresh adapters" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Command="{Binding RefreshAdaptersCommand}"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{Binding AdminNotice}" TextWrapping="Wrap" FontSize="12.5" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Local adapter" Style="{StaticResource SectionHeader}"/>
                        <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}"/>
                                        <TextBlock Text="{Binding Mac, StringFormat='  ({0})'}"
                                                   Foreground="{StaticResource Brush.SubText}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="New MAC address" Style="{StaticResource SectionHeader}"/>
                        <TextBox Text="{Binding NewMac, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
                        <Button Content="Change MAC" Style="{StaticResource AccentButton}" Margin="0,0,8,0"
                                Command="{Binding ChangeMacCommand}"/>
                        <Button Content="Restore original" Command="{Binding RestoreMacCommand}" Margin="0,0,8,0"/>
                        <Button Content="Copy MAC" Command="{Binding CopyMacCommand}"
                                CommandParameter="{Binding SelectedAdapter}"/>
                    </StackPanel>
                </Grid>
                <Border Background="{StaticResource Brush.Panel}" CornerRadius="6" Padding="10,7" Margin="0,12,0,0">
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12.5"/>
                </Border>
                <TextBlock Text="Changing a MAC writes the Windows driver 'NetworkAddress' registry value and restarts the adapter - the network drops for a few seconds. Only supported on adapters whose driver allows it; NetControl reports the actual result honestly."
                           Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Local adapters" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <DataGrid ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80"/>
                            <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="150"/>
                            <DataGridTextColumn Header="IP" Binding="{Binding Ips[0]}" Width="120"/>
                            <DataGridTextColumn Header="Gateway" Binding="{Binding Gateway}" Width="120"/>
                            <DataGridTextColumn Header="DHCP" Binding="{Binding DhcpEnabled}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Discovered device MACs" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                              DisplayMemberPath="DisplayName" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Copy MAC" Command="{Binding CopyMacCommand}"
                                CommandParameter="{Binding SelectedDevice}" Margin="0,0,8,0"/>
                        <Button Content="Identify manufacturer" Command="{Binding LookupVendorCommand}"/>
                    </StackPanel>
                    <Border Background="{StaticResource Brush.Panel}" CornerRadius="6" Padding="10,7">
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12.5"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
